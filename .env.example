# Dossier — OKX.AI ASP (x402 pay-per-call). Payment handled by @okxweb3/x402-hono.
# Copy to .env on the host. Never commit real values.

# CAIP-2 network for X Layer mainnet.
X402_NETWORK=eip155:196

# Price per call as a USD string; the SDK settles in USD₮0 on X Layer.
# PRICE is the /verdict route, DOSSIER_PRICE is /dossier.
PRICE=$0.20
DOSSIER_PRICE=$0.50

# ASP payout wallet (from `onchainos wallet` after login). The payment
# middleware stays unmounted until this AND the OKX credentials below are set,
# and the paid routes then answer 503 rather than serving for free.
PAY_TO=

# OKX facilitator API credentials (OKX developer portal). Used server-side to
# verify and settle payments. Belongs on the deployed host, not a dev box.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# Shared secret for our own A2A fulfilment daemon, which fetches a report to
# push into a marketplace job channel after the buyer already paid at the task
# level. Requests carrying this in `x-internal-key` skip the payment gate, so
# it must be long, random, and never a buyer-facing value. Leave empty to
# disable the bypass entirely.
INTERNAL_KEY=

# Where delivered reports are archived so a buyer who lost the paid response
# can recover it. Defaults to ~/.dossier-archive. Records are pruned after 90
# days or 5000 entries. If the path is unwritable, archiving silently
# degrades to a no-op and deliveries are unaffected.
# ARCHIVE_DIR=

# Canonical public origin, advertised as the resource URL in the payment
# challenge. Behind a TLS-terminating proxy the request arrives over plain HTTP,
# so a URL derived from it would advertise http:// to buyers who reached us over
# https, and strict clients reject that as a downgrade.
# PUBLIC_ORIGIN=https://dossier.rouma.xyz

# Port for the standalone server (src/server.ts). Defaults to 8787.
# PORT=3000

# Rate limiting on the free endpoints (never on paid paths). Defaults to
# "observe", which logs what it would have blocked without blocking, so the
# budgets can be checked against real traffic first. Set to "enforce" to return
# 429 once a budget is exceeded. Both modes log the moment a client starts
# being blocked, and every hundredth block after that — grep the journal for
# "[ratelimit]" to see whether real traffic is hitting the budgets.
# RATE_LIMIT_MODE=enforce

# DEV ONLY — never set in production. Skips the payment middleware so the
# engine can be exercised locally without credentials.
# DEV_SKIP_PAYMENT=1
