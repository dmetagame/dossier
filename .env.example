# Verdict — OKX.AI ASP (x402 pay-per-call). Payment handled by @okxweb3/x402-hono.

# CAIP-2 network for X Layer mainnet.
X402_NETWORK=eip155:196
# Price per call as a USD string. SDK settles in USD₮0 on X Layer.
PRICE=$0.20
# ASP payout wallet (from `onchainos wallet` after login). Middleware stays
# unmounted until this AND the OKX creds below are set.
PAY_TO=

# OKX facilitator API credentials (OKX developer portal). Used server-side to
# verify + settle payments. Runs from the deployed host, not the dev box.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# DEV ONLY — never set in production. Skips the payment middleware so the
# verdict engine can be exercised locally without credentials.
# DEV_SKIP_PAYMENT=1
