# Dossier — OKX.AI ASP (x402 pay-per-call). Payment handled by @okxweb3/x402-hono.
# Copy to .env on the host. Never commit real values.

# CAIP-2 network for X Layer mainnet.
X402_NETWORK=eip155:196

# Price per call as a USD string; the SDK settles in USD₮0 on X Layer.
# Must match the fee on OKX service 36013: a marketplace task is funded from the
# listing fee, so a listing cheaper than this leaves the buyer short and the
# purchase cannot settle at all.
DOSSIER_PRICE=$0.01

# ASP payout wallet (from `onchainos wallet` after login). The payment
# middleware stays unmounted until this AND the OKX credentials below are set,
# and the paid routes then answer 503 rather than serving for free.
PAY_TO=

# OKX facilitator API credentials (OKX developer portal). Used server-side to
# verify and settle payments. Belongs on the deployed host, not a dev box.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# Shared secret for our own A2A fulfilment daemon, which fetches a report to
# push into a marketplace job channel after the buyer already paid at the task
# level. Requests carrying this in `x-internal-key` skip the payment gate, so
# it must be long, random, and never a buyer-facing value. Leave empty to
# disable the bypass entirely.
INTERNAL_KEY=

# Where delivered reports are archived so a buyer who lost the paid response
# can recover it. Defaults to ~/.dossier-archive. The 90-day/5000-entry pruning
# policy currently applies only to records without durable transaction, job, or
# replay ownership; paid x402 records and replay/claim sidecars are retained indefinitely until a
# compact permanent-tombstone cleanup design is implemented. Pending/unknown
# attempts also publish authenticated report-indexed replay holds, so pruning
# preserves their staged bytes until definite-unpaid cleanup or reconciliation.
# If the path is unwritable, paid delivery fails before settlement.
# ARCHIVE_DIR=

# Optional keyed authentication for archive records. With a key configured and
# strict mode off, new records are signed and existing unsigned records remain
# readable; /health reports this explicitly as migration mode.
# ARCHIVE_MAC_KEY=

# Historical builds could derive their archive MAC from a different secret and
# covered a smaller field set. Supply that exact old secret only to the offline
# migration audit so an existing MAC can be verified before being replaced.
# The running service does not use this variable.
# ARCHIVE_LEGACY_MAC_KEY=

# Require authenticated archive records and transaction ownership claims.
# Never enable this merely by signing files in place. Use `pnpm archive:migrate`
# while the standalone service is stopped: audit, review and authenticate an
# exact approval inventory, create an external checksummed backup, apply the
# plan, and run strict verification. Request-keyed v1 files must first move to a
# separately checksummed cold archive outside ARCHIVE_DIR; they are preserved as
# history, not assigned invented ids or payment ownership. Strict mode rejects
# unsigned, incompatible, malformed, or ambiguous current records.
# ARCHIVE_MAC_REQUIRED=1

# Stable HMAC key for payment replay/reconciliation sidecars. It never encrypts
# or stores PAYMENT-SIGNATURE; it derives an opaque fingerprint from the decoded
# payment payload and the exact server requirements. Paid routes stay closed
# when this is absent so a used nonce cannot bypass retry recovery.
PAYMENT_REPLAY_KEY=

# Canonical public origin, advertised as the resource URL in the payment
# challenge. Behind a TLS-terminating proxy the request arrives over plain HTTP,
# so a URL derived from it would advertise http:// to buyers who reached us over
# https, and strict clients reject that as a downgrade.
# PUBLIC_ORIGIN=https://dossier.rouma.xyz

# Port for the standalone server (src/server.ts). Defaults to 8787.
# PORT=3000

# Rate limiting on unauthenticated work, including new or malformed /dossier
# payment attempts. Authenticated internal calls and exact payment retries that
# already have durable replay state bypass it so a possibly-paid buyer can
# always reach reconciliation. Defaults to "enforce"; set to "observe" only to
# log what would have been blocked without returning 429. Both modes log the
# first request over budget and every hundredth after that — grep the journal
# for "[ratelimit]" to see whether real traffic is hitting the budgets.
# RATE_LIMIT_MODE=enforce

# DEV ONLY — never set in production. Skips the payment middleware so the
# engine can be exercised locally without credentials.
# DEV_SKIP_PAYMENT=1

# Ed25519 seed (32 bytes as 64 hex chars) used to sign report attestations, so a
# buyer can verify a report against the key published at
# /.well-known/dossier-signing-key.json. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Without it reports still carry a payload hash, but no signature, and they say
# so. Changing it invalidates every signature issued under the old key.
# SIGNING_KEY=
